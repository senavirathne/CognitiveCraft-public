{
  "workRadius": 12,
  "maxAgents": 32,
  "maxActivePlans": 8,
  "concurrentLlmRequests": 2,
  "autoFoodThreshold": 8,
  "autonomousCheckTicks": 1200,
  "replanCooldownTicks": 6000,
  "respawnDelaySeconds": 60,
  "deathMode": "permanent",
  "preserveMemory": true,
  "allowCloudDialogue": false,
  "providers": [
    {
      "id": "gemini",
      "type": "gemini",
      "endpoint": "https://generativelanguage.googleapis.com/v1beta",
      "model": "",
      "apiKeyEnv": "GEMINI_API_KEY",
      "enabled": false,
      "jsonMode": true,
      "dailyRequests": 40,
      "minimumIntervalSeconds": 10,
      "timeoutSeconds": 25,
      "dailyTokenBudget": 300000
    },
    {
      "id": "cloudflare",
      "type": "cloudflare",
      "endpoint": "https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1/chat/completions",
      "model": "",
      "apiKeyEnv": "CLOUDFLARE_API_TOKEN",
      "enabled": false,
      "jsonMode": true,
      "dailyRequests": 40,
      "minimumIntervalSeconds": 10,
      "timeoutSeconds": 25,
      "dailyTokenBudget": 300000
    },
    {
      "id": "groq",
      "type": "groq",
      "endpoint": "https://api.groq.com/openai/v1/chat/completions",
      "model": "",
      "apiKeyEnv": "GROQ_API_KEY",
      "enabled": false,
      "jsonMode": true,
      "dailyRequests": 40,
      "minimumIntervalSeconds": 10,
      "timeoutSeconds": 25,
      "dailyTokenBudget": 300000
    },
    {
      "id": "ollama",
      "type": "ollama",
      "endpoint": "http://127.0.0.1:11434/api/chat",
      "model": "",
      "apiKeyEnv": "",
      "enabled": false,
      "jsonMode": true,
      "dailyRequests": 40,
      "minimumIntervalSeconds": 10,
      "timeoutSeconds": 25,
      "dailyTokenBudget": 300000
    }
  ]
}